Bootstrap: docker
# Ubuntu 24.04, not 22.04: apptainer 1.5.3 on the build host runs %post under its bundled
# `faked`, which is linked against GLIBC_2.38. The 22.04 base ships 2.35, so every %post died
# with "version `GLIBC_2.38' not found" and the build could not proceed. 24.04 ships 2.39.
# CUDA 12.6.3 because NVIDIA's 24.04 variants start at 12.6 -- 12.4.1 has none -- and the
# image installs `jax[cuda12]`, so the 13.x line is not an option.
From: nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

# Reproduces one STalign port-vs-upstream comparison notebook from pinned, public sources.
# Build from the repository root:
#     apptainer build container/stalign.sif container/stalign.def
# See container/README.md for how to run it.

%files
    pyproject.toml /opt/squidpy-ports/pyproject.toml
    uv.lock /opt/squidpy-ports/uv.lock
    README.md /opt/squidpy-ports/README.md
    LICENSE /opt/squidpy-ports/LICENSE
    src /opt/squidpy-ports/src
    # Vendored upstream STalign (pinned submodule) carries its own notebooks AND the
    # example datasets, so the image is self-contained and needs no network at run time.
    vendor /opt/squidpy-ports/vendor
    # The comparison notebooks the container executes (each fits upstream + the JAX port).
    docs/notebooks/stalign-merfish-comparison.ipynb /opt/squidpy-ports/docs/notebooks/stalign-merfish-comparison.ipynb
    docs/notebooks/stalign-visium-affine-comparison.ipynb /opt/squidpy-ports/docs/notebooks/stalign-visium-affine-comparison.ipynb
    docs/notebooks/stalign-xenium-comparison.ipynb /opt/squidpy-ports/docs/notebooks/stalign-xenium-comparison.ipynb

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    # build-essential: some transitive deps (mahotas, via squidpy -> cp-measure) ship no wheel
    # for this Python and compile from source.
    apt-get install -y --no-install-recommends git curl ca-certificates build-essential
    rm -rf /var/lib/apt/lists/*

    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

    cd /opt/squidpy-ports
    # No .git in the image, so hand the version generators the same values the cluster job
    # used instead of deriving them from tags.
    export SETUPTOOLS_SCM_PRETEND_VERSION=1.8.3.dev0
    export SETUPTOOLS_SCM_PRETEND_VERSION_FOR_SQUIDPY=1.8.3.dev0

    # squidpy-ports (this repo) supplies upstream PyTorch; the pinned squidpy fork supplies
    # the JAX port. jax[cuda12] gives GPU JAX; the default Linux torch wheel is CUDA-enabled.
    uv sync --frozen
    # Pinned to the SHA that was the tip of feat/experimental-fit-core at authoring time.
    # Change @<sha> to @feat/experimental-fit-core to track the branch instead. nbclient +
    # ipykernel execute the notebooks; the resolved commit is recorded in each run's manifest.
    uv pip install --python .venv/bin/python \
        "squidpy[jax] @ git+https://github.com/selmanozleyen/squidpy@9735ba3c8198ba279f3f688df92ba5a6876e28c4" \
        "jax[cuda12]" nbclient nbformat ipykernel watermark
    # Register a python3 kernel inside the env so the notebook executor finds it.
    .venv/bin/python -m ipykernel install --sys-prefix --name python3 --display-name python3

    # The comparison notebooks read their inputs from docs/_build/stalign-data/<dir>. The
    # vendored STalign checkout carries those exact files, so point there: a run finds the data
    # present and skips the download, keeping it offline. The link name must match each
    # notebook's expected dir -- xenium omits the `_data` suffix the others use.
    mkdir -p docs/_build/stalign-data
    ln -sfn /opt/squidpy-ports/vendor/STalign/docs/merfish_data docs/_build/stalign-data/merfish_data
    ln -sfn /opt/squidpy-ports/vendor/STalign/docs/visium_data  docs/_build/stalign-data/visium_data
    ln -sfn /opt/squidpy-ports/vendor/STalign/docs/xenium_data  docs/_build/stalign-data/xenium

%environment
    export PATH=/opt/squidpy-ports/.venv/bin:$PATH
    export JAX_ENABLE_X64=1
    # The image has no .git, so upstream.load() reads the pin from here (see upstream.py).
    export SQUIDPY_PORTS_STALIGN_SHA=b2068edc98974efa54537eca194736e177bbe11d
    # Keep matplotlib's cache on the writable overlay, not a bound $HOME on Lustre.
    export MPLCONFIGDIR=/tmp/mpl

%runscript
    cd /opt/squidpy-ports
    # Execute one comparison notebook -> executed notebook + panel + manifest in /output. e.g.
    #   apptainer run --nv --bind ./out:/output stalign.sif stalign-xenium-comparison.ipynb
    exec python -m squidpy_ports.stalign.execute_comparison \
        "${1:-stalign-xenium-comparison.ipynb}" \
        --output-dir "${STALIGN_OUTPUT:-/output}"

%labels
    upstream.stalign b2068edc98974efa54537eca194736e177bbe11d
    squidpy.fork selmanozleyen/squidpy@9735ba3c8198ba279f3f688df92ba5a6876e28c4
