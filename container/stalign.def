Bootstrap: docker
# Ubuntu 24.04, not 22.04: apptainer 1.5.3 on the build host runs %post under its bundled
# `faked`, which is linked against GLIBC_2.38. The 22.04 base ships 2.35, so every %post died
# with "version `GLIBC_2.38' not found" and the build could not proceed. 24.04 ships 2.39.
# CUDA 12.6.3 because NVIDIA's 24.04 variants start at 12.6 -- 12.4.1 has none -- and the
# image installs `jax[cuda12]`, so the 13.x line is not an option.
From: nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

# Reproduces one of the squidpy-API STalign notebooks from pinned, public sources.
# Build from the repository root:
#     apptainer build container/stalign.sif container/stalign.def
# See container/README.md for how to run it.

%files
    pyproject.toml /opt/squidpy-ports/pyproject.toml
    uv.lock /opt/squidpy-ports/uv.lock
    README.md /opt/squidpy-ports/README.md
    LICENSE /opt/squidpy-ports/LICENSE
    src /opt/squidpy-ports/src
    # Vendored upstream STalign (pinned submodule) carries its own notebooks AND the
    # example datasets, so the image is self-contained and needs no network at run time.
    vendor /opt/squidpy-ports/vendor
    # The public-API notebooks the container executes.
    docs/notebooks/squidpy-api /opt/squidpy-ports/docs/notebooks/squidpy-api

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    # build-essential: some transitive deps (mahotas, via squidpy -> cp-measure) ship no wheel
    # for this Python and compile from source.
    apt-get install -y --no-install-recommends git curl ca-certificates build-essential
    rm -rf /var/lib/apt/lists/*

    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

    cd /opt/squidpy-ports
    # No .git in the image, so hand the version generators the same values the cluster job
    # used instead of deriving them from tags.
    export SETUPTOOLS_SCM_PRETEND_VERSION=1.8.3.dev0
    export SETUPTOOLS_SCM_PRETEND_VERSION_FOR_SQUIDPY=1.8.3.dev0

    # squidpy-ports (this repo) supplies upstream PyTorch; the pinned squidpy fork supplies
    # the JAX port. jax[cuda12] gives GPU JAX; the default Linux torch wheel is CUDA-enabled.
    uv sync --frozen
    # Pinned to the SHA that was the tip of feat/experimental-fit-core at authoring time.
    # Change @<sha> to @feat/experimental-fit-core to track the branch instead. nbclient +
    # ipykernel execute the notebooks.
    uv pip install --python .venv/bin/python \
        "squidpy[jax] @ git+https://github.com/selmanozleyen/squidpy@6c4b5ce93b100f43fe873949aef6446461a276c0" \
        "jax[cuda12]" nbclient nbformat ipykernel watermark
    # Register a python3 kernel inside the env so the notebook executor finds it.
    .venv/bin/python -m ipykernel install --sys-prefix --name python3 --display-name python3

    # The notebooks resolve their inputs relative to the working directory. The
    # vendored STalign checkout carries those exact files, so point there: a run finds the data
    # present and skips the download, keeping it offline. The link name must match each
    # notebook's expected dir -- xenium omits the `_data` suffix the others use.
    mkdir -p docs/_build/stalign-data
    for d in heart_data merfish_data starmap_data visium_data xenium_data; do
        ln -sfn "/opt/squidpy-ports/vendor/STalign/docs/$d" "docs/_build/stalign-data/$d"
    done
    # The two `*-allen3Datlas` notebooks read the Allen atlas from the working directory. Upstream
    # downloads it per run; fetching it once at build makes the image self-contained and stops
    # every run re-pulling ~40 MB twice over.
    ALLEN=http://download.alleninstitute.org/informatics-archive/current-release/mouse_ccf
    curl -fsSL -o docs/_build/stalign-data/ara_nissl_50.nrrd "$ALLEN/ara_nissl/ara_nissl_50.nrrd"
    curl -fsSL -o docs/_build/stalign-data/annotation_50.nrrd "$ALLEN/annotation/ccf_2017/annotation_50.nrrd"
    curl -fsSgL -o docs/_build/stalign-data/allen_ontology.csv \
        "http://api.brain-map.org/api/v2/data/query.csv?criteria=model::Structure,rma::criteria,[ontology_id\$eq1],rma::options[num_rows\$eqall]"
    for f in ara_nissl_50.nrrd annotation_50.nrrd allen_ontology.csv; do
        test -s "docs/_build/stalign-data/$f" || { echo "atlas fetch produced no $f" >&2; exit 1; }
    done
    ls -l docs/_build/stalign-data/

%environment
    export PATH=/opt/squidpy-ports/.venv/bin:$PATH
    export JAX_ENABLE_X64=1
    # The image has no .git, so upstream.load() reads the pin from here (see upstream.py).
    export SQUIDPY_PORTS_STALIGN_SHA=b2068edc98974efa54537eca194736e177bbe11d
    # Keep matplotlib's cache on the writable overlay, not a bound $HOME on Lustre.
    export MPLCONFIGDIR=/tmp/mpl

%runscript
    # Execute one public-API notebook -> the executed notebook, with its figures, in /output. e.g.
    #   apptainer run --nv --bind ./out:/output stalign.sif merfish-merfish.ipynb
    #
    # nbclient rather than nbconvert: one fewer dependency, and it takes the working directory
    # directly, which is what the notebooks resolve their inputs against.
    cd /opt/squidpy-ports/docs/_build/stalign-data
    NB="${1:-merfish-merfish.ipynb}"
    exec /opt/squidpy-ports/.venv/bin/python - "$NB" "${STALIGN_OUTPUT:-/output}" <<'PY'
import sys, nbformat
from nbclient import NotebookClient

name, out = sys.argv[1], sys.argv[2]
nb = nbformat.read(f"/opt/squidpy-ports/docs/notebooks/squidpy-api/{name}", as_version=4)
NotebookClient(nb, timeout=None, kernel_name="python3",
               resources={"metadata": {"path": "."}}).execute()
nbformat.write(nb, f"{out}/{name}")
print(f"wrote {out}/{name}")
PY

%labels
    upstream.stalign b2068edc98974efa54537eca194736e177bbe11d
    squidpy.fork selmanozleyen/squidpy@6c4b5ce93b100f43fe873949aef6446461a276c0
